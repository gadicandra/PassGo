# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001
LOG_LEVEL=info
# Base URL untuk member `type` pada Problem Details (RFC 9457)
PROBLEM_TYPE_BASE=https://github.com/gadicandra/PassGo/blob/main/docs/api-contract.md

# Database (MongoDB; use a replica set for transactions)
MONGODB_URI=mongodb://localhost:27017/passgo?replicaSet=rs0

# Auth
# Minimal 256 bit acak: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_ISSUER=berkah-pos-api
JWT_AUDIENCE=berkah-pos
# Refresh token berupa string acak opak (bukan JWT), hanya hash-nya yang disimpan
REFRESH_TOKEN_TTL=7d
# Origin yang boleh memanggil endpoint cookie (refresh/logout), dipisah koma
CSRF_ALLOWED_ORIGINS=http://localhost:3001

# Business
STORE_TIMEZONE=Asia/Jakarta

# Midtrans (QRIS)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_NOTIFICATION_URL=https://your-tunnel.example.com/api/v1/payments/midtrans/notifications
