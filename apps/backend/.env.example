# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001
LOG_LEVEL=info
# Base URL untuk member `type` pada Problem Details (RFC 9457)
PROBLEM_TYPE_BASE=https://github.com/gadicandra/PassGo/blob/main/docs/api-contract.md

# Database (MongoDB Atlas; SRV sudah berupa replica set sehingga transaksi jalan)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/passgo?appName=PassGo

# Auth
# Minimal 256 bit acak: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_ISSUER=passgo-api
JWT_AUDIENCE=passgo
# Refresh token berupa string acak opak (bukan JWT), hanya hash-nya yang disimpan
REFRESH_TOKEN_TTL=7d
# Origin yang boleh memanggil endpoint cookie (refresh/logout), dipisah koma
CSRF_ALLOWED_ORIGINS=http://localhost:3001

# Business
APP_TIMEZONE=Asia/Jakarta
ORDER_HOLD_MINUTES=30
FRONTEND_URL=http://localhost:3001

# Midtrans (QRIS)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_NOTIFICATION_URL=https://your-tunnel.example.com/api/v1/payments/midtrans/notifications

# Storage poster (opsional; kosong = poster disimpan di ./uploads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=posters
# Dipakai untuk membentuk posterUrl saat storage lokal
PUBLIC_BASE_URL=http://localhost:3000
